@page
@using Microsoft.AspNetCore.Razor.Language
@using final_project_CIDM_3312.Models
@model final_project_CIDM_3312.Pages_Genres.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<span class="input-group-text"><i class="bi bi-search"></i></span>
<input class="form-control me-2" type="search" name="CurrentSearch" value="@Model.CurrentSearch" placeholder="Search" aria-label="Search">
<button class="btn btn-outline-success" type="submit">Search</button>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Genre[0].ImageURL)
            </th>
            <th>
                @{
                    //Alternate sort order
                    var firstSort = "first_asc";
                    if (Model.CurrentSort == "first_asc")
                    {
                        firstSort = "first_desc";
                    }
                }
                <a asp-page="./Index" asp-route-CurrentSort="@firstSort" asp-route-PageNum="@Model.PageNum">@Html.DisplayNameFor(model => model.Genre[0].GenreName)</a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre[0].GenreDesc)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Genre) {
        <tr>
            <td>
                <div class="col-6">
                    <img class="img-fluid" src="@Html.DisplayFor(model => item.ImageURL)" alt="...">
                </div>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GenreName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GenreDesc)
            </td>
            @foreach(var game in item.GameGenres!)
            {
                <td>
                    @Html.DisplayFor(modelItem => game.Game.GameName)
                </td>
            }
            <td>
                <a asp-page="./Edit" asp-route-id="@item.GenreID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.GenreID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.GenreID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
